# Copy to .env in the project root (git-ignored). Never commit a real key.

# ZRO (https://zro.moonmath.ai) is the primary AI provider.
# Create a key under Account -> API keys and give it a spend quota and an expiry date.
ZRO_API_KEY=
# Optional. Defaults to deepseek-v4.1-flash (the model with free daily usage).
ZRO_MODEL=
# Optional. none | low | high | max. Defaults to none. Reasoning tokens count against
# ZRO_MAX_TOKENS: with "low" and 16000, a 7-page PDF used the whole allowance and returned
# no lesson. Leave both empty unless you have tested other values.
ZRO_REASONING_EFFORT=
# Optional. Maximum output tokens per lesson, reasoning included. Defaults to 32000.
ZRO_MAX_TOKENS=

# Optional alternative provider. The old default model (gemini-2.5-flash) is retired for
# new keys, so set GEMINI_MODEL if you use it.
GEMINI_API_KEY=
GEMINI_MODEL=

# "zro", "gemini" or "mock". Leave empty to use ZRO when its key is set, then Gemini,
# otherwise the offline mock.
AI_PROVIDER=

PORT=8787
HOST=127.0.0.1
# Comma-separated browser origins allowed to call this server.
ALLOWED_ORIGINS=http://localhost:3000
# New courses a client may start per 10 minutes, and total AI calls per day.
RATE_LIMIT_MAX=6
DAILY_GENERATION_CAP=200

# Adaptive generation budget for ONE course: 1 planning request + 1 request per lesson.
# The plan may use up to COURSE_MAX_REQUESTS - 2 lessons. Leave empty for the defaults.
COURSE_MAX_REQUESTS=
COURSE_MAX_TOKENS=
# Output caps for one planning request and one lesson request. Defaults: 8000 and 6000.
PLAN_MAX_TOKENS=
LESSON_MAX_TOKENS=
