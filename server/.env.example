# Copy to .env in the project root (git-ignored). Never commit a real key.

# Get a free-tier key at https://aistudio.google.com/apikey (do not enable billing).
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash; change if Google renames free-tier models.
GEMINI_MODEL=

# "gemini" or "mock". Leave empty to use Gemini when a key is set, otherwise the offline mock.
AI_PROVIDER=

PORT=8787
HOST=127.0.0.1
# Comma-separated browser origins allowed to call this server.
ALLOWED_ORIGINS=http://localhost:3000
# Requests per client per 10 minutes, and total AI calls per day.
RATE_LIMIT_MAX=6
DAILY_GENERATION_CAP=200
